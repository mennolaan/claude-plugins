{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pr-gate.sh\"", "timeout": 30 },
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/state-guard.sh\"", "timeout": 30 }
        ]
      },
      {
        "matcher": "mcp__.*(create_pull_request|create_merge_request)",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pr-gate.sh\"", "timeout": 30 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/state-guard.sh\"", "timeout": 30 }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/quiz-pre.sh\"", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/quiz-post.sh\"", "timeout": 30 }
        ]
      }
    ]
  }
}
